PORT=3000
JWT_SECRET=your_jwt_secret_key_here

# DATABASE CONFIGURATION
# Local SQLite Testing URL (default):
DATABASE_URL="file:./dev.db"

# Neon PostgreSQL Cloud Database URL (Uncomment when deploying):
